# Vitalis — переменные окружения
# Скопируйте в .env и заполните. Без ключей AI работает в mock-режиме.

# --- Node (форма + лендинг) ---
PORT=3000
NODE_ENV=development

# Яндекс.Метрика (пока нет — оставьте пустым)
YANDEX_METRIKA_ID=

# Прокси к Python API
PYTHON_API_URL=http://127.0.0.1:8000

# Telegram (заявки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email SMTP (заявки)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vitalis <noreply@vitalis.local>
LEADS_EMAIL_TO=

# Локальное хранилище заявок
LEADS_JSON_PATH=./server/data/leads.json
LEADS_DB_PATH=./server/data/leads.db

# --- Python (продукт / RAG / LLM) ---
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000
VAULT_PATH=../vault
FAISS_INDEX_PATH=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GigaChat — резервная заглушка. В личном режиме оставьте отключённым.
GIGACHAT_ENABLED=false
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# DeepSeek — рабочая модель для обоих контуров (РФ и международного)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Веб-поиск: duckduckgo (без ключа) | serper | tavily
WEB_SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
TAVILY_API_KEY=

# Режим без ключей: mock | live
LLM_MODE=mock

# Поведение при недоступном веб-поиске: warn (ответ с предупреждением) | strict (блокировка)
EVIDENCE_GATE_MODE=warn
